# Required for AI-powered document and rejection analysis. Also enables system-wide language translation as an OpenAI fallback. Keep this server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional Supabase foundation (not required for local-first mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional system-wide Indian language translation (BHASHINI).
# Create a project in https://bhashini.gov.in/ and use the ULCA User ID + API key.
# Keep both credentials server-side. They must never use NEXT_PUBLIC_ prefixes.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
